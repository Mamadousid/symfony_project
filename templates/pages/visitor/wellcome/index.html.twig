    <script>
      document.querySelector('.burger').addEventListener('click', function() {
         document.querySelector('.nav-links').classList.toggle('active');
      });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const videos = document.querySelectorAll('.videos video');
        const arrowLeft = document.querySelector('.arrow-left');
        const arrowRight = document.querySelector('.arrow-right');
        let currentVideo = 0;

        function updateVideoPosition() {
            const offset = -currentVideo * 100;
            videos.forEach(video => {
                video.style.transform = `translateX(${offset}%)`;
            });
        }

        arrowLeft.addEventListener('click', function() {
            currentVideo = (currentVideo === 0) ? videos.length - 1 : currentVideo - 1;
            updateVideoPosition();
        });

        arrowRight.addEventListener('click', function() {
            currentVideo = (currentVideo === videos.length - 1) ? 0 : currentVideo + 1;
            updateVideoPosition();
        });

        updateVideoPosition(); // Initial update
    });
</script>

    {% endblock %}
</body>
</html>
