{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des réservations{% endblock %}

{% block description %}Liste des réservations{% endblock %}

{# jQuery #}
{% block jQuery %}
     <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer">
     </script>
{% endblock %}

{# DataTables #}
{% block dataTables %}
    <link href="https://cdn.datatables.net/v/bs5/dt-2.1.2/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.2/datatables.min.js"></script>
    <script>
      $(document).ready( function () 
      {
          $('#table').DataTable({
            language: {
                   url: 'https://cdn.datatables.net/plug-ins/2.1.2/i18n/fr-FR.json',
            },
          });
      } );
</script>
{% endblock %}


{% block main %}
    <h1 class="text-center my-3 display-5">Liste des réservations</h1>

    {% include 'components/alert.html.twig' %}



    <div class="table-responsive">
          <table id="table" class="table table-striped table-hover table-bordered text-center">
               <thead class="table-dark">
                   <tr>
                      <th>Id</th>
                      <th>Nom</th>
                      <th>Prénom</th>
                      <th>Email</th>
                      <th>Date de réservation</th>
                      <th>Heure</th>
                      <th>Minutes</th>
                      <th>Nombre de personnes</th>
                      <th>Type de table</th>
                      <th>Message</th>
                      <th>Envoyée le</th>
                      <th>Options</th>
                   </tr>
               </thead>
               <tbody>
                    {% for booking in bookings %}
                        <tr>
                           <td>{{ booking.id }}</td>
                           <td>{{ booking.firstName }}</td>
                           <td>{{ booking.lastName }}</td>
                           <td>{{ booking.email }}</td>
                           <td>{{ booking.dateBooking|date('Y-m-d') }}</td>
                           <td>{{ booking.timeMeal.heure }}</td> <!-- Assurez-vous que 'heure' est une propriété dans TimeMeal -->
                           <td>{{ booking.minutes.minute }}</td> <!-- Assurez-vous que 'minute' est une propriété dans MinutesRepas -->
                           <td>{{ booking.guest }}</td>
                           <td>{{ booking.typetable.name }}</td> <!-- Assurez-vous que 'name' est une propriété dans Table -->
                            <td>
                               <a data-bs-toggle="modal" data-bs-target="#modal_{{booking.id}}" href="#" class="text-dark" ><i class="fa-solid fa-book-open-reader"></i></a>

                                 <!-- Modal -->
                                  <div class="modal fade" id="modal_{{booking.id}}" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                      <div class="modal-content">
                                        <div class="modal-header">
                                          <p class="modal-title fs-5" id="staticBackdropLabel">{{booking.firstName}} {{booking.lastName}}</p>
                                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                          {{ booking.message|nl2br }}
                                        </div>
                                        <div class="modal-footer">
                                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                            </td>
                           <td>{{ booking.createdAt|date('Y-m-d H:i:s') }}</td>
                            <td>
                               <a class="mx-2 text-secondary" href="{{path('admin_booking_edit', {'id':booking.id})}}"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a onclick="event.preventDefault(); return confirm('Confirmer la supression?') && document.querySelector('#delete_booking_{{booking.id}}_form').submit();" class="mx-2 text-danger" href=""><i class="fa-solid fa-trash"></i></a>

                                <form id="delete_booking_{{booking.id}}_form" method="POST" action="{{path('admin_booking_delete', {'id':booking.id})}}">
                                      <input type="hidden" name="_method" value="DELETE">
                                      <input type="hidden" name="csrf_token" value="{{csrf_token('delete_booking_'~booking.id)}}">
                                </form> 
                            </td>
                        </tr>
                    {% endfor %}
               </tbody>
          </table>
    </div>
{% endblock %}
