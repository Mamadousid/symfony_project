{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des horaires de repas{% endblock %}

{% block description %}Liste des horaires de repas{% endblock %}

{# jQuery #}
{% block jQuery %}
     <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer">
     </script>
{% endblock %}

 {# DataTables #}
{% block dataTables %}
    <link href="https://cdn.datatables.net/v/bs5/dt-2.1.2/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.2/datatables.min.js"></script>
    <script>
      $(document).ready( function () 
      {
          $('#table').DataTable({
            language: {
                   url: 'https://cdn.datatables.net/plug-ins/2.1.2/i18n/fr-FR.json',
            },
          });
      } );
</script>
{% endblock %}


{% block main %}
    <h1 class="text-center my-3 display-5">Liste des horaires de repas</h1>

    {% include 'components/alert.html.twig' %}

        <div class="d-flex justify-content-end align-items-center my-3">
         <a href="{{path('admin_timemeal_create')}}" class="btn btn-primary shadow"><i class="fa-solid fa-plus"></i> Nouvelle horaire de repas</a>
    </div>

    <div class="table-responsive">
          <table id="table" class="table table-striped table-hover table-bordered text-center">
               <thead class="table-dark">
                   <tr>
                      <th>Id</th>
                      <th>Heures</th>
                      <th>Options</th>
                   </tr>
               </thead>
               <tbody>
                    {% for timemeal in timemeals %}
                        <tr>
                           <td>{{timemeal.id}}</td>
                           <td>{{timemeal.heure}}</td>
                         <td>
                               <a class="mx-2 text-secondary" href="{{path('admin_timemeal_edit', {'id':timemeal.id})}}"><i class="fa-solid fa-pen-to-square"></i></a>
                                 <a onclick="event.preventDefault(); return confirm('Confirmer la supression?') && document.querySelector('#delete_timemeal_{{timemeal.id}}_form').submit();" class="mx-2 text-danger" href=""><i class="fa-solid fa-trash"></i></a>

                               <form id="delete_timemeal_{{timemeal.id}}_form" method="POST" action="{{path('admin_timemeal_delete', {'id':timemeal.id})}}">
                                      <input type="hidden" name="_method" value="DELETE">
                                      <input type="hidden" name="csrf_token" value="{{csrf_token('delete_timemeal_'~timemeal.id)}}">
                                </form> 
                           </td>
                        </tr>
                    {% endfor %}
               </tbody>
          </table>
    </div>
{% endblock %}