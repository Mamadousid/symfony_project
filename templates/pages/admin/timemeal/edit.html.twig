{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier cette heure de repas{% endblock %}

{% block description %}Modifier cette heure de repas{% endblock %}

{% block main %}
    <h1 class="text-center my-3 display-5">Modifier cette heure de repas</h1>

    <div class="container mt-5">
        <div class="row">
             <div class="col-md-6 mx-auto">
                   {{form_start(form)}}
                        <div class="mb-3">
                            <label for="time_meal_form_heure">Heure</label>
                            <div class="text-danger">{{ form_errors(form.heure) }}</div>
                            {{ form_widget(form.heure, {"attr": {"class":"form-control", "autofocus":"autofocus"}}) }}
                        </div>
                        <div>
                            <input formnovalidate type="submit" class="btn btn-primary shadow" value="Modifié">
                        </div>
                   {{form_end(form)}}
             </div>
        </div>
    </div>

{% endblock %}