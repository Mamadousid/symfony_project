<!DOCTYPE html>
<html lang="fr">
<head>
     
    {# L'encodage de caractères #} 
    <meta charset="UTF-8">

    {# Le minimum de responsive design #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Le titre de chaque page dans l'onglet #}
    <title>{% block title %}{% endblock %} - Le Restaurant Toque'OR</title>

    {# La description de chaque page #}
    <meta name="description" content="{% block description %}{% endblock %}">

    {# Les balises utiles pour le SEO #}
    <meta name="robots" content="index, follow">

    <meta name="author" content="dwwm">
    <meta name="publisher" content="dwwm">

    {# La Favicon #}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

     {# Font awesome #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

     {% block stylesheets %}
            {# 'app' must match the first argument to addEntry() in webpack.config.js #}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    
    {# Ma feuille de style #}
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>


   {# La barre de navigation#}
   

   <nav class="navbar navbar-expand-lg" style="background-color: #000000; height: 70px">
   <div class="container-fluid">
   <a href="{{path('visitor_wellcome_index')}}" ><img class="logo" src="./images/logo.png" alt=""></a>
   <img class="mobile-img" style="display: none;" src="./images/burger.png" alt="Menu">
   <ul class="navbar mt-2" style="margin-right: 20px;"> 
        <li><a href="{{path('visitor_wellcome_index')}}">Accueil</a></li>
        <li><a href="{{path('visitor_main_index')}}">Menu</a></li>
        <li><a href="{{path('visitor_contact_create')}}">Contact</a></li>
        <li><a href="{{path('visitor_event_index')}}">Evennement</a></li>

       
          
             {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                 <li class="nav-item">
                      <a href="{{path('admin_home_index')}}" class="btn btn-success">Espace admin</a>
                 </li>
                {% endif %}

                {% if is_granted('ROLE_USER') %}
                  <li class="nav-item">
                      <a href="{{path('user_home_index')}}" class="btn btn-secondary">Espace user</a>
                 </li>
                 <li class="nav-item">
                      <a href="#" class="btn btn-warning">Réservation</a>
                 </li>
                {% endif %}
                
                
                <li class="nav-item">
                <a href="{{path('app_logout')}}" class="btn btn-outline-danger">Déconnexion</a>
                </li>

             {% else %}
                 <li class="nav-item">
                     <a href="{{path('visitor_authentication_login')}}" class="btn btn-secondary">Compte</a>
                 </li>

                 <li class="nav-item">
                     <a href="{{path('visitor_registration_register')}}" class="btn btn-outline-warning shadow">RESERVER</a>
                 </li>
             {% endif %}

        </div>
        </ul>
   </nav>
   



    {# Le contenu spécifique à chaque page #}
    {% block main %}{% endblock %}


    <footer class="container-fluid text-center mt-5 p-3" style="background-color: #000000">
         <div class="container-fluid text-white" >
            <div class="row">
               <div class="col-12 col-md-12 col-lg-4">
                  <h3>Adresse</h3>
                  <p class="text-footer">Le Toque'OR</p>
                  <p class="text-footer">56 Boulevard Magenta</p>
                  <p class="text-footer">75008 Paris</p>
                  <p class="text-footer">01 01 01 01 01</p>
               </div>

               <div class="col-12 col-md-12 col-lg-4">
                   <h3>Horaires</h3>
                   <p class="text-footer">Lundi-jeu:19h00 à 00h00</p>
                   <p class="text-footer">Ven:19h00 à 1h</p>
                   <p class="text-footer">Sam:12h00 à 1h</p>
                   <p class="text-footer">Dim:12h à 2h</p>
               </div>

               <div class="col-12 col-md-12 col-lg-4">
                  <div>
                   <h3>Juridique</h3>
                   <div><a class="text-footer" style="font-size: 13px;" href="">Polique de confidentialité</a></div>
                   <div class="mb-5"><a class="text-footer" style="font-size: 13px;" href="">Mentions légales</a></div>
                  </div>

                  <div class="mb-5">
                    <h3 style="font-size: 13px;">Suivez-nous!</h3>
                    <div>
                    <a href=""><img class="mx-1" width="30" height="30" src="./images/instagram.png"  alt="Icone réseau social"></a>
                    <a href=""><img class="mx-1" width="30" height="30" src="./images/snapchat.png"  alt="Icone réseau social"></a>
                    </div>
                  </div> 
               </div>
            </div>
         </div>
    </footer>

</body>
</html>