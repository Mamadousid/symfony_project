<!DOCTYPE html>
<html lang="fr">
<head>
    <!-- Meta, titre, favicon, etc. restent inchangés -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} - Le Restaurant Toque'OR</title>
    <meta name="description" content="{% block description %}{% endblock %}">
    <meta name="robots" content="index, follow">
    <meta name="author" content="dwwm">
    <meta name="publisher" content="dwwm">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    <link rel="stylesheet" href="/css/welcome.css">
</head>
<body>

    <!-- Barre de navigation principale -->
    <nav class="navbar" style="background-color: #000000;">
        <div class="logo">
            <a href="{{ path('visitor_main_index') }}">
                <img src="/images/logo.png" alt="Logo du Restaurant Toque'OR">
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="{{ path('visitor_wellcome_index') }}">Accueil</a></li>
            <li><a href="{{ path('visitor_main_index') }}">Menu</a></li>
            <li><a href="{{ path('visitor_booking_create') }}">Réservation</a></li>
            <li><a href="{{ path('visitor_contact_create') }}">Contact</a></li>
            <li><a href="{{ path('visitor_event_index') }}">Evennements</a></li>
            
            <!-- Icon account with dropdown menu -->
            {% if is_granted('ROLE_USER') %}
                <!-- Pour les utilisateurs connectés avec ROLE_USER -->
                <li class="nav-item account-menu">
                    <i class="fa fa-user"></i>
                    <ul class="dropdown-menu">
                        <li><a href="{{ path('user_profile_index') }}">Mon profil</a></li>
                        <li><a href="{{ path('user_bookings_index') }}">Gérer mes réservations</a></li>
                         <!-- Lien pour les administrateurs -->
                        {% if is_granted('ROLE_ADMIN') %}
                            <li><a href="{{ path('admin_home_index') }}">Administration</a></li>
                        {% endif %}

                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </li>
            {% else %}
                <!-- Pour les utilisateurs non connectés -->
                <li class="nav-item account-menu">
                    <i class="fa fa-user"></i>
                    <ul class="dropdown-menu">
                        <li><a href="{{ path('visitor_authentication_login') }}">Connexion</a></li>
                        <li><a href="{{ path('visitor_registration_register') }}">Inscription</a></li>
                    </ul>
                </li>
            {% endif %}
        </ul>
        <div class="burger">
            <i class="fa fa-bars"></i>
        </div>
    </nav>

    <!-- Contenu spécifique à chaque page -->
    {% block main %}{% endblock %}

    <!-- Bouton "Remonter en haut" -->
    <button id="scrollToTopBtn" class="scrollToTopBtn">
        <i class="fa fa-arrow-up"></i>
    </button>

    <!-- Pied de page -->
    <footer class="container-fluid text-center mt-5 p-3" style="background-color: #000000;">
        <div class="container text-white">
            <div class="row">
                <div class="col-12 col-md-4">
                    <h3>Adresse</h3>
                    <p class="text-footer">Le Toque'OR</p>
                    <p class="text-footer">56 Boulevard Magenta</p>
                    <p class="text-footer">75008 Paris</p>
                    <p class="text-footer">01 01 01 01 01</p>
                </div>
                <div class="col-12 col-md-4">
                    <h3>Horaires</h3>
                    <p class="text-footer">Lundi-jeu: 19h00 à 00h00</p>
                    <p class="text-footer">Ven: 19h00 à 01h00</p>
                    <p class="text-footer">Sam: 12h00 à 01h00</p>
                    <p class="text-footer">Dim: 12h00 à 02h00</p>
                </div>
                <div class="col-12 col-md-4">
                    <h3>Juridique</h3>
                    <div><a class="text-footer" href="">Politique de confidentialité</a></div>
                    <div><a class="text-footer" href="">Mentions légales</a></div>
                    <div class="mt-3">
                        <h3>Suivez-nous !</h3>
                        <a href="https://www.instagram.com/" target="_blank">
                            <img class="mx-1" width="30" height="30" src="./images/instagram.png" alt="Instagram">
                        </a>
                        <a href="https://www.snapchat.com/" target="_blank">
                            <img class="mx-1" width="30" height="30" src="./images/snapchat.png" alt="Snapchat">
                        </a>
                    </div>
                </div>
            </div>
            <div id="copyright" class="footer-container">
                © Toque'OR Paris. Tous Droits Réservés / All Rights Reserved.
            </div>
        </div>
    </footer>
    
    <!-- Inclusion des fichiers JavaScript via Webpack Encore -->
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    <!-- Script pour gérer le bouton "Remonter en haut" -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrollToTopBtn = document.getElementById('scrollToTopBtn');
            
            // Fonction pour afficher ou masquer le bouton
            function toggleScrollToTopBtn() {
                if (window.scrollY > 200) {
                    scrollToTopBtn.style.display = "flex";
                } else {
                    scrollToTopBtn.style.display = "none";
                }
            }

            // Fonction pour remonter en haut de la page
            function scrollToTop() {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }

            // Écouteurs d'événements
            window.addEventListener('scroll', toggleScrollToTopBtn);
            scrollToTopBtn.addEventListener('click', scrollToTop);
        });
    </script>
</body>
</html>
